{
  "name": "zippcart-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:api": "node scripts/start-local-backend.mjs",
    "setup:admin": "node scripts/setup-admin-password.mjs",
    "test:admin-auth": "node scripts/test-admin-auth.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests/acceptance tests/local tests/phase-2-contracts.test.mjs tests/unit/dom-*.test.cjs tests/unit/helpers/load-dom.cjs next.config.mjs playwright.config.ts tsconfig.json",
    "test": "node scripts/test.cjs",
    "audit:web": "node scripts/audit-web.cjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "jspdf": "^4.0.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
